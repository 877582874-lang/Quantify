[Unit]
Description=Quant system v2 - order book service, 4 local books + 5s snapshots
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/quant-system
Environment=PYTHONPATH=/opt/quant-system/pylib
ExecStart=/usr/bin/python3 /opt/quant-system/books_service.py
Restart=always
RestartSec=10
StandardOutput=append:/opt/quant-system/logs/books.log
StandardError=append:/opt/quant-system/logs/books.log

[Install]
WantedBy=multi-user.target
